# png is ok, but dds is advised
# about 256 * 256, with alpha.
#技术提示-如何添加纸片人肖像，注意，请务必订阅工坊的二向箔mod！
#作为示范的内容，你应当在复制以后修改所有的hatsune_miku为你自己的内容
#而且如果要添加其他组的肖像，应当和vocaloid这个文件夹为平行目录
#并复制本文件（要改名）和hm_prohet.mesh（不要改名）
#每往对应头像组下面加一个头像，都要复制一次下述内容，截止到下一次出现这句话。
pdxmesh = {
	name = "touhou_marisa_mesh"
	file = "hm_prophet.mesh"
	scale = 0.8
	meshsettings = {
		name = "prophet_shieldShape"
		index = 0
		texture_diffuse = "touhou_marisa.dds"
		texture_specular = "touhou_marisa.dds"
		shader = "portrait_attachment_alpha_to_coverage"
		shader_file = "gfx/hmportrait.shader"
	}
}
entity = {
	name = "touhou_marisa_entity"
	pdxmesh = "touhou_marisa_mesh"
}

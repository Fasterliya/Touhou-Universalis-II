situation_panel = {
	blockoverride "situation_subheader_content" {}

	blockoverride "situation_panel_main_content" {
		widget = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			# 背景图槽位：gfx/interface/illustrations/situation/chronicle/chronicle_bg.dds
			# 推荐比例 3:4（570 x 760 @1x / 1140 x 1520 @2x），用户替换该 dds 即可
			background = {
				texture = "gfx/interface/illustrations/situation/chronicle/chronicle_bg.dds"
				spriteType = stretched
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				text_single = {
					using = Font_Type_Headers
					using = Font_Size_Big
					default_format = "#header_titles"
					text = "TH_CULTURE_CHRONICLE_TITLE"
				}

				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 12

					button_regular = {
						size = { 120 32 }
						text_single = {
							text = "TH_CULTURE_CHRONICLE_PREV_PAGE"
						}
						onclick = "[GetScriptedGui('th_cc_prev_page').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					}
					text_single = {
						using = Font_Size_Medium
						default_format = "#subtle_name"
						text = "TH_CULTURE_CHRONICLE_PAGE_INDICATOR"
					}
					text_single = {
						using = Font_Size_Medium
						default_format = "#subtle_name"
						raw_text = "[FixedPointToInt(GetPlayer.MakeScope.GetVariable('th_cc_page_display').GetValue)]/[FixedPointToInt(GetPlayer.MakeScope.GetVariable('th_cc_total_pages').GetValue)]"
					}
					button_regular = {
						size = { 120 32 }
						text_single = {
							text = "TH_CULTURE_CHRONICLE_NEXT_PAGE"
						}
						onclick = "[GetScriptedGui('th_cc_next_page').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					}
				}

				widget = {
					layoutpolicy_horizontal = expanding
					size = { -1 4 }
				}

				scrollarea = {
					layoutpolicy_horizontal = expanding
					size = { -1 480 }
					scrollbarpolicy_horizontal = always_off
					scrollbar_vertical = {
						using = Scrollbar_Vertical
					}
									scrollwidget = {
					vbox = {
					# 图鉴卡片：静态枚举（主序列固定顺序，每页 7 行，共 17 页），纹理与文本全部写死
					# 页面可见性 = th_cc_page 变量比较；行内真文化版/占位版 = th_cc_row_<N>_adopted 变量切换（EqualTo_CFixedPoint 为原版 situation 同款写法）
						# ===== 第 1 页（行 0 - 6，共 7 行） =====
						vbox = {
							visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('th_cc_page').GetValue, '(CFixedPoint)0')]"
							# 行 0（主序列 #0）：th_goblin_culture
							widget = {
								size = { 100% 192 }
								hbox = {
									layoutpolicy_horizontal = expanding
									spacing = 10
									icon = {
										size = { 120 180 }
										texture = "gfx/interface/illustrations/situation/chronicle/th_goblin_culture.dds"
										visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('th_cc_row_0_adopted').GetValue, '(CFixedPoint)1')]"
									}
									icon = {
										size = { 120 180 }
										texture = "gfx/interface/illustrations/situation/chronicle/unknown.dds"
										visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('th_cc_row_0_adopted').GetValue, '(CFixedPoint)0')]"
									}
									vbox = {
										layoutpolicy_horizontal = expanding
										text_single = {
											using = Font_Size_Medium
											text = "th_goblin_culture"
											visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('th_cc_row_0_adopted').GetValue, '(CFixedPoint)1')]"
										}
										widget = {
											size = { -1 4 }
										}
										text_single = {
											using = Font_Size_Small
											layoutpolicy_horizontal = expanding
											align = left|nobaseline
											autoresize = no
											size = { -1 100 }
											text = "th_cc_desc_th_goblin_culture"
											visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('th_cc_row_0_adopted').GetValue, '(CFixedPoint)1')]"
										}
										text_single = {
											using = Font_Size_Medium
											text = "th_chronicle_unknown"
											visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('th_cc_row_0_adopted').GetValue, '(CFixedPoint)0')]"

                                                visible = "[Country.MakeScope.GetVariable('th_gensokyo_tier_2_mark').IsSet]"
                                                raw_text = "[Localize('TH_TRIBUNAL_TIER_LABEL')] [Localize('th_gensokyo_tier_2_mark')]"
                                            }

situation_panel = {

	##################################### MAIN IMAGE #####################################
	# 双国头部：FirstCountry = 审判目标国（situation 变量动态引用），SecondCountry = 阎魔（IO 领袖）
	# 写法参考 base game hussite_wars.gui + th_gensokyo_crusade.gui

	blockoverride "situation_panel_image" {
		using = two_countries_header_template

		blockoverride "FirstCountryContext" {
			datacontext = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('th_gensokyo_trial_target_ref').GetCountry]"
		}

		blockoverride "SecondCountryContext" {
			datacontext = "[GetUniqueInternationalOrganization('th_gensokyo_io').GetLeaderCountry]"
		}

		blockoverride "first_character_portrait_anchor" {
			parentanchor = bottom|left
		}

		blockoverride "second_character_portrait_anchor" {
			parentanchor = bottom|right
		}

		blockoverride "character_religion_visibility" {
			visible = no
		}

		blockoverride "character_name_maximumsize" {
			maximumsize = { 270 -1 }
		}
	}

	##################################### SUBHEADER #####################################

	blockoverride "situation_subheader_content" {}

	##################################### HEADER LEFT / RIGHT：阶段与剩余投票月 #####################################

	blockoverride "situation_header_left" {
		vbox = {
			layoutpolicy_horizontal = expanding
			text_single = {
				fontsize = 15
				text = "TH_TRIAL_PHASE_LABEL"
				default_format = "#subtle_name"
			}
			text_single = {
				layoutpolicy_horizontal = expanding
				fontsize = 13
				text = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('th_gensokyo_trial_phase').GetValue|0]"
			}
		}
		expand = {}
	}

	blockoverride "situation_header_right" {
		vbox = {
			layoutpolicy_horizontal = expanding
			text_single = {
				fontsize = 15
				text = "TH_TRIAL_VOTE_MONTHS_LABEL"
				default_format = "#subtle_name"
			}
			text_single = {
				layoutpolicy_horizontal = expanding
				fontsize = 13
				text = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('th_gensokyo_trial_vote_months').GetValue|0]"
			}
		}
		expand = {}
	}

	##################################### MAIN CONTENT：投票统计（风味） #####################################

	blockoverride "situation_panel_main_content" {
		situation_card_expandable = {
			blockoverride "header_button_onclick" {
				onclick = "[LateralView.Vars.Toggle( 'trial_votes_toggled' )]"
			}
			blockoverride "header_text" {
				text = "TH_TRIAL_VOTE_TALLY_LABEL"
			}
			blockoverride "header_icon" {
				texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
			}
			blockoverride "bottom_content" {
				vbox = {
					spacing = 4
					text_single = {
						layoutpolicy_horizontal = expanding
						fontsize = 13
						text = "TH_TRIAL_VOTE_MERCY"
						default_format = "#subtle_name"
					}
					text_single = {
						layoutpolicy_horizontal = expanding
						fontsize = 15
						text = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('th_gensokyo_trial_vote_mercy').GetValue|0]"
					}
					text_single = {
						layoutpolicy_horizontal = expanding
						fontsize = 13
						text = "TH_TRIAL_VOTE_ORDER"
						default_format = "#subtle_name"
					}
					text_single = {
						layoutpolicy_horizontal = expanding
						fontsize = 15
						text = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('th_gensokyo_trial_vote_order').GetValue|0]"
					}
					text_single = {
						layoutpolicy_horizontal = expanding
						fontsize = 13
						text = "TH_TRIAL_VOTE_KARMA"
						default_format = "#subtle_name"
					}
					text_single = {
						layoutpolicy_horizontal = expanding
						fontsize = 15
						text = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('th_gensokyo_trial_vote_karma').GetValue|0]"
					}
				}
			}
			blockoverride "visible_hint" {}
			### P1-11 修复（同惩戒局势）：基类正文可见性/图标替换默认绑定 GetVariableSystem['toggled']，
			### 与 header 按钮的 LateralView.Vars 不同源 → 补齐三件套统一绑定
			blockoverride "bottom_content_onclick" {
				visible = "[LateralView.Vars.Exists( 'trial_votes_toggled' )]"
			}
			blockoverride "icon_replace_visible_yes" {
				visible = "[LateralView.Vars.Exists( 'trial_votes_toggled' )]"
			}
			blockoverride "icon_replace_visible_not" {
				visible = "[Not(LateralView.Vars.Exists( 'trial_votes_toggled' ))]"
			}
		}
	}
}
